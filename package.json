{
  "name": "prisma-hello",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy:prod": "npm run build && dotenvx run -- bunx @prisma/cli@latest app deploy --prod --entry src/server.ts",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3000 tsx watch src/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "start": "tsx src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.24",
