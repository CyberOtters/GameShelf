{
  "name": "prisma-hello",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "dotenvx run -f deploy.env -- bunx @prisma/cli@latest app deploy --db --env deploy.env",
    "dev": "STAGE=development concurrently -n server,css,js -c blue,yellow,magenta \"npm:dev:server\" \"npm:dev:css\" \"npm:dev:js\"",
    "dev:server": "PORT=3000 tsx watch src/server/index.ts",
    "dev:css": "sass --watch src/client:dist/client/assets",
    "dev:js": "node esbuild.config.js --client --watch",
    "build": "npm run build:client && npm run build:server",
    "build:client": "rm -rf dist/client && sass src/client:dist/client/assets --no-source-map && node esbuild.config.js --client",
    "build:server": "node esbuild.config.js --server && rm -rf dist/views && cp -R src/server/views dist/views",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "start": "tsx src/server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.24",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/cli": "^3.0.0-beta.29",
    "@prisma/client": "^7.9.0",
    "@types/ejs": "^3.1.5",
    "better-auth": "^1.6.24",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.17.2",
    "@prisma/compute-sdk": "^0.36.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "prisma": "^7.9.0",
    "sass": "^1.101.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
