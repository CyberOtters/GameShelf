    "@prisma/cli": "^3.0.0-beta.29",
    "@prisma/client": "^7.9.0",
    "better-auth": "^1.6.24",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.17.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
