{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true,
    "noImplicitAny": false
  },
  "include": [
    "src/server",
    "prisma.config.ts",
    "vite.config.ts",
    "prisma.compute.ts"
  ]
}
