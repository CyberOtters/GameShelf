<%- include('partials/header', {
  title: 'GameShelf — Your Shelf',
  stageId: 'stage',
  tagline: null
}) %>

<section class="shelf-bar">
  <div class="badge">
    <div class="avatar" aria-hidden="true"><%= user.name.trim().charAt(0).toUpperCase() %></div>
    <div class="who">
      <span class="label">Now playing</span>
      <span class="name"><%= user.name %></span>
    </div>
  </div>

  <div class="shelf-actions">
    <button type="button" class="btn" id="open-add-form">Add Game</button>
    <button type="button" class="btn ghost" id="sign-out">Sign Out</button>
  </div>
</section>

<dialog class="card form-modal" id="game-form-dialog" aria-labelledby="game-form-title">
  <div class="ridges" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <form id="game-form">
    <div class="form-heading">
      <h2 id="game-form-title">Add Game</h2>
      <button type="button" class="close-modal" id="close-game-form" aria-label="Close">×</button>
    </div>

    <div class="field">
      <label for="game-title">Title</label>
      <input id="game-title" type="text" name="title" required maxlength="100" autofocus placeholder="Super Mario Bros. 3">
    </div>

    <div class="field">
      <label for="game-platform">Platform</label>
      <select id="game-platform" name="platform" required>
        <option value="">Choose a platform</option>
        <option value="PC">PC</option>
        <option value="PS5">PS5</option>
        <option value="Xbox">Xbox</option>
        <option value="Nintendo Switch">Nintendo Switch</option>
      </select>
    </div>

    <div class="field">
      <label for="game-status">Status</label>
      <select id="game-status" name="status" required>
        <option value="WISHLIST">Wishlist</option>
        <option value="BACKLOG" selected>Backlog</option>
        <option value="PLAYING">Playing</option>
        <option value="COMPLETED">Completed</option>
        <option value="DROPPED">Dropped</option>
      </select>
    </div>

    <fieldset class="field priority-field">
      <legend>Priority</legend>

      <label class="choice">
        <input type="radio" name="priority" value="HIGH">
        High
      </label>

      <label class="choice">
        <input type="radio" name="priority" value="MEDIUM">
        Medium
      </label>

      <label class="choice">
        <input type="radio" name="priority" value="LOW">
        Low
      </label>
    </fieldset>

    <div class="field">
      <label for="game-rating">Rating</label>
      <input id="game-rating" type="number" name="rating" min="1" max="10" placeholder="1–10">
    </div>

    <label class="choice">
      <input type="checkbox" name="archived">
      Archived
    </label>

    <div class="field">
      <label for="game-notes">Notes</label>
      <textarea id="game-notes" name="notes" rows="3" maxlength="500"></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn" id="save-game-button">Save Game</button>
      <button type="button" class="btn ghost" id="cancel-game-form">Cancel</button>
    </div>
  </form>
</dialog>

<dialog class="card form-modal" id="session-form-dialog" aria-labelledby="session-form-title">
  <div class="ridges" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <form id="session-form">
    <div class="form-heading">
      <h2 id="session-form-title">Log Session</h2>
      <button type="button" class="close-modal" id="close-session-form" aria-label="Close">×</button>
    </div>

    <p class="session-game-label" id="session-game-label"></p>

    <div class="field">
      <label for="session-hours">Hours played</label>
      <input id="session-hours" type="number" name="hours" required min="0.1" max="999.9" step="0.1" placeholder="2.5">
    </div>

    <div class="field">
      <label for="session-date">Session date</label>
      <input id="session-date" type="date" name="sessionDate" required>
    </div>

    <div class="field">
      <label for="session-notes">Notes</label>
      <textarea id="session-notes" name="notes" rows="3" maxlength="500" placeholder="Optional — what did you play?"></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn" id="save-session-button">Log Session</button>
      <button type="button" class="btn ghost" id="cancel-session-form">Cancel</button>
    </div>
  </form>
</dialog>

<p id="shelf-message" class="shelf-message">Loading games…</p>

<section class="game-grid" id="game-grid"></section>

<%- include('partials/footer') %>
