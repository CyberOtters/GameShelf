<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎮</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Karla:ital,wght@0,400;0,600;0,800;1,400&display=swap" rel="stylesheet" />
  <% assets.css.forEach(function (href) { %>
  <link rel="stylesheet" href="<%= href %>" />
  <% }) %>
  <script type="module" src="<%= assets.js %>"></script>
</head>
<body>
  <span class="deco d1">A</span>
  <span class="deco d2">B</span>
  <span class="deco d3">↑↑↓↓</span>
  <span class="deco d4">←→←→</span>

  <main class="stage"<% if (stageId) { %> id="<%= stageId %>"<% } %>>
    <header class="logo">
      <h1>GAME<span class="accent">SHELF</span></h1>
      <% if (tagline) { %><p><%= tagline %></p><% } %>
    </header>
