generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Game {
  id       Int        @id @default(autoincrement())
  userId   String
  title    String     @db.VarChar(100)
  platform String     @db.VarChar(30)
  priority Priority?
  status   GameStatus @default(BACKLOG)
  rating   Int?       @db.SmallInt
  coverUrl String?    @db.VarChar(255)
  addedAt  DateTime   @default(now())

  sessions      PlaySession[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]
}

model PlaySession {
  id          Int      @id @default(autoincrement())
  gameId      Int
  userId      String
  hours       Decimal  @db.Decimal(4, 1)
  sessionDate DateTime @db.Date
  notes       String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  userId     String
  gameId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(100)
  priceLimit Decimal? @db.Decimal(6, 2)
  savedAt    DateTime @default(now())
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  games         Game[]
  wishlistItems WishlistItem[]
  playSessions  PlaySession[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}
