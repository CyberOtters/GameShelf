STAGE="development"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
TWITCH_CLIENT_ID="your-twitch-app-client-id"
TWITCH_CLIENT_SECRET="your-twitch-app-client-secret"
PRISMA_PROJECT_ID=
BETTER_AUTH_SECRET="replace-with-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
PORT="3000"

# After `npx prisma dev`, replace DATABASE_URL with the URL it prints.
# The local port can change between runs — update .env if it does.

# Demo account (npm run db:seed) — see src/server/lib/demoAccount.ts
#   Email:    demo@gameshelf.dev
#   Password: demo-password
